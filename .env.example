# Copy to .env and fill in. .env is gitignored and must never be committed.
# Each community's operator issues its own token; scope one per community.

# Admin API v2 token, issued by the community operator (Developers -> Tokens)
CIRCLE_ADMIN_TOKEN__acme_founders=

# Headless Auth token, issued by the community operator (Business plan+)
CIRCLE_HEADLESS_AUTH_TOKEN__acme_founders=

# The community_member_id identifying YOUR authorized member account there
CIRCLE_MEMBER_ID__acme_founders=

# Optional: LLM semantic classification (layer 2)
ANTHROPIC_API_KEY=

# --- Web dashboard -----------------------------------------------------
# Required. The dashboard refuses to start without it (min 8 characters).
DASHBOARD_PASSWORD=

# Optional: set so sessions survive a restart. Generated per-run if absent.
DASHBOARD_SECRET_KEY=

# Optional: signs the reply drafts shown in the dashboard.
DASHBOARD_YOUR_NAME=

# Set to true only when serving over HTTPS (breaks plain-HTTP localhost).
DASHBOARD_HTTPS=

# --- Community search (optional) --------------------------------------
# For `circle-leads search-web`. Without a key it falls back to a keyless
# DuckDuckGo scrape (works, but may rate-limit). Brave has a free tier.
EXA_API_KEY=
BRAVE_API_KEY=
SERPAPI_API_KEY=

# --- Production lead ingest (Warmr / Vini) -----------------------------
# New LEADs are POSTed to the Vini ingest edge function. Without both
# keys the scraper still works locally; remote sync is skipped.
SUPABASE_ANON_KEY=
VINI_API_SECRET=
# Optional override (defaults to the Warmr production function URL):
# VINI_LEADS_INGEST_URL=https://jlhesealocmkwmphxuqb.supabase.co/functions/v1/vini_leads_ingest

# --- Remote browser (server-hosted Chromium; PoC, off by default) ------
# Measured result: Circle serves an automated server browser a Cloudflare
# challenge, so this is NOT a working ingest route. See
# docs/remote_browser_poc.md. Left in place so the finding can be re-tested
# if Circle's policy changes. Requires an image with Chromium installed.
REMOTE_BROWSER_ENABLED=
# Persistent profile dir. On Railway point this at a mounted volume so a
# login would survive a redeploy.
REMOTE_BROWSER_PROFILE=
