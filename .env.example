# Copy to .env and fill in. .env is gitignored and must never be committed.
# Each community's operator issues its own token; scope one per community.

# Admin API v2 token, issued by the community operator (Developers -> Tokens)
CIRCLE_ADMIN_TOKEN__acme_founders=

# Headless Auth token, issued by the community operator (Business plan+)
CIRCLE_HEADLESS_AUTH_TOKEN__acme_founders=

# The community_member_id identifying YOUR authorized member account there
CIRCLE_MEMBER_ID__acme_founders=

# Optional: LLM semantic classification (layer 2)
ANTHROPIC_API_KEY=
