# Read every community you're a member of, on your machine, every few hours.
# Your login lives in the browser profiles under ~/.circle-leads/ -- you sign
# into each community once (read-feed <host> --login); cron reuses those
# sessions until they expire, then that community is skipped until you re-login.
#
# Install:  crontab -e   (edit the path)
#
# minute hour ... command
0 */4 * * *  cd /path/to/circle-scraper && ./.venv/bin/circle-leads read-all --use-llm >> ~/.circle-leads/read-all.log 2>&1
#
# Then review leads in the dashboard (Leads tab) or:  circle-leads search
