__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.coverage
htmlcov/

# Secrets — never commit
.env
*.secret
secrets.yaml
**/config/communities/*.yaml
**/config/communities/*.yml
!**/config/communities/*.yaml.template

# Local data
data/
*.db
*.sqlite3
exports/
circle-search.log
harvest.log
logs/
**/config/communities/member_feeds.yaml

# Local Circle Connector — MUST stay on the local machine, never in Git.
# The authenticated Circle browser session, profiles, and the connector API
# token live here. Default location is ~/.circle-leads (outside the repo), but
# these patterns also catch a profile/state dir pointed inside the repo.
.circle-leads/
circle_profiles/
browser-profile/
connector.json
**/browser-profile/

# Remote-browser profile (server-hosted Chromium PoC). Holds a live Circle
# session if anyone ever logs in through it — never commit it.
remote-profile/
**/remote-profile/
.vercel
.env*

# macOS folder metadata
.DS_Store
**/.DS_Store

# Scratch and one-off working files. These are local by design: agent
# scratchpads, ad-hoc API dumps kept while debugging a discovery run, and the
# manual test notes for the join driver. None of it is reproducible output, so
# it does not belong in history -- but it is also NOT backed up anywhere, so
# treat anything here as disposable.
scratchpad/
new.json
new2.json
circle tests/

# Bulk host exports used to seed discovery (RapidDNS, Censys, BuiltWith, …).
# Tens of thousands of lines of third-party DNS data: too large and too
# licence-encumbered for the repo. The communities they produced live in the
# database; the raw export is a local input, not a source file.
rapiddns exports/
*.rapiddns.txt
